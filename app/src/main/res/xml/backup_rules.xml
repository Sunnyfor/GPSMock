<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 及以下使用的完整备份规则；新系统的规则见 data_extraction_rules.xml。
    默认排除全部私有数据，收藏和模拟资源账本不应在另一台设备恢复。
    规则来源：https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
